    {
      "id": "QZ_ontSwAO7wx0a1BL0iH",
      "type": "text",
      "x": 525.71875,
      "y": 935.28515625,
      "width": 561.2796020507812,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Y",
      "roundness": null,
      "seed": 1004152841,
      "version": 995,
      "versionNonce": 2101871209,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786898486723,
      "link": null,
      "locked": false,
      "text": "Lead Agent: Used for access the complexity of the query\n- system prompt\n    - use agent as small as possible\n    - prioritize ConsultationAgent\n    - only used for assign tasks\n    - description of each agent\n    - how to assign \n        - simple sympton\n    - output format\n        - use json for each subagent\n    - keypoint \n        - only need description and assigned_agent \n- Assess and Decompose\n    - use llm.chat(system prompt + query)\n        - this will output assignment\n        -  need to verify if this returns a json format\n        - provide fallback strategy\n\n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lead Agent: Used for access the complexity of the query\n- system prompt\n    - use agent as small as possible\n    - prioritize ConsultationAgent\n    - only used for assign tasks\n    - description of each agent\n    - how to assign \n        - simple sympton\n    - output format\n        - use json for each subagent\n    - keypoint \n        - only need description and assigned_agent \n- Assess and Decompose\n    - use llm.chat(system prompt + query)\n        - this will output assignment\n        -  need to verify if this returns a json format\n        - provide fallback strategy\n\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
