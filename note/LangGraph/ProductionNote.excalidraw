      "seed": 1262397453,
      "version": 431,
      "versionNonce": 1499399886,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786722119379,
      "link": null,
      "locked": false,
      "text": "+ call() -> Union[BaseMessage, BaseModel]: call _call_with_fallback\n- _invoke_with_retry() @Retry(tenacity) -> retry with the same model\n- _call_with_fallback()\n    * check if model name exists\n    * strategy pattern to determine target (current) and advance (next to run)\n    * call _fallback_loop\n- _fallback_loop() -> try each model\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+ call() -> Union[BaseMessage, BaseModel]: call _call_with_fallback\n- _invoke_with_retry() @Retry(tenacity) -> retry with the same model\n- _call_with_fallback()\n    * check if model name exists\n    * strategy pattern to determine target (current) and advance (next to run)\n    * call _fallback_loop\n- _fallback_loop() -> try each model\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 194
    },
