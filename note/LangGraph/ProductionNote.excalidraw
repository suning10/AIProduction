      "updated": 1786648247566,
      "link": null,
      "locked": false,
      "text": "python way sort \n\nsorted = sorted(iterable(students), key = lambda x: x[1], reverse = True) # deep copy, keep original \nstudents.sort(key = lambda x: x[1], reverse = True) # change original list\nstudents = [(a,85), (b,90)] \n\npython way pq \npq = []\nheapqpush(heap, val)\nheapqpop(heap)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "python way sort \n\nsorted = sorted(iterable(students), key = lambda x: x[1], reverse = True) # deep copy, keep original \nstudents.sort(key = lambda x: x[1], reverse = True) # change original list\nstudents = [(a,85), (b,90)] \n\npython way pq \npq = []\nheapqpush(heap, val)\nheapqpop(heap)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
