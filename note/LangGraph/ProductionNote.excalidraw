    {
      "id": "BodKtkspsc6afziU3fHcx",
      "type": "text",
      "x": 561.2000122070312,
      "y": 226.10000610351562,
      "width": 598.837890625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
