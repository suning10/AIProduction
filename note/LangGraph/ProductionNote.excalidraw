      "type": "text",
      "x": 551.2000122070312,
      "y": 273.1000061035156,
      "width": 777.6195068359375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
