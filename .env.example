# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-5-mini

# Atlas Cloud (OpenAI-compatible) — alternative to OpenAI, access 59+ LLMs with one key
# Get your free key at: https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Inventory gap (SCR) investigation agent
# mock = in-process fake SCR API; http = call INVENTORY_API_BASE_URL (EcomToolBox server, /admin/scr/*)
INVENTORY_API_MODE=mock
INVENTORY_API_BASE_URL=http://localhost:80
# Endpoint contracts (URLs, params/body templates, field mappings); defaults to app/core/inventory_endpoints.json
# INVENTORY_ENDPOINTS_FILE=/path/to/inventory_endpoints.json
INVENTORY_API_TIMEOUT_SECONDS=30
INVENTORY_API_CACHE_TTL_SECONDS=300
# Comma-separated slocs to scan by default; empty = discover from scrReportSummary
INVENTORY_SLOCS=
INVENTORY_MAX_CONCURRENCY=8
INVENTORY_LOOKBACK_DAYS=30
INVENTORY_RECON_PADDING_DAYS=2
INVENTORY_MAX_SKUS=500
INVENTORY_LLM_CLASSIFY_ENABLED=true
INVENTORY_MOCK_SKU_COUNT=40
# Simple explained SKUs (one discrepancy kind, <= N discrepancies) get a template; 0 = resolver agent for every SKU
INVENTORY_TEMPLATE_MAX_DISCREPANCIES=3
INVENTORY_RESOLVE_MAX_TOOL_ROUNDS=3
INVENTORY_KB_CACHE_TTL_SECONDS=3600
RATE_LIMIT_INVENTORY_INVESTIGATE="5 per minute"
RATE_LIMIT_INVENTORY_READ="60 per minute"
